---
import { Image } from "astro:assets";
import drone from "../../public/images/drone.jpg";
import { Links } from "./link";

const projects = [
  {
    eyebrow: "Simulation · Team project",
    title: "Drone Simulation System",
    description:
      "A scalable drone delivery simulation built with C++, JavaScript, and Docker. The system applies software design patterns to keep new entities and behaviors easy to extend.",
    tags: ["C++", "JavaScript", "Docker", "Design patterns"],
    image: drone,
  },
  {
    eyebrow: "Hackathon · Full stack",
    title: "Event Crowdfunding Platform",
    description:
      "A full-stack platform for launching and supporting event campaigns, built during a fast-paced hackathon with secure authentication and payment workflows.",
    tags: ["React", "Next.js", "Clerk", "Stripe"],
  },
];
---

<section class="portfolio" aria-labelledby="projects-title">
  <div class="container">
    <div class="heading left animation">
      <p class="eyebrow">SELECTED WORK</p>
      <h2 id="projects-title">Projects built with purpose.</h2>
      <p class="intro">
        A few things I’ve designed and developed across simulation, product, and
        full-stack engineering.
      </p>
    </div>
    <div class="project-grid">
      {
        projects.map((project, index) => (
          <article class:list={["card", { featured: index === 0 }]}>
            {project.image ? (
              <div class="image-wrap">
                <Image
                  src={project.image}
                  alt="Drone simulation interface"
                  widths={[520, 900]}
                  sizes="(max-width: 767px) 100vw, 55vw"
                  loading="lazy"
                />
              </div>
            ) : (
              <div class="code-art" aria-hidden="true">
                <span>01</span>
                <span>CREATE</span>
                <span>FUND</span>
                <span>GO</span>
              </div>
            )}
            <div class="card-content">
              <p class="card-eyebrow">{project.eyebrow}</p>
              <h3>{project.title}</h3>
              <p class="description">{project.description}</p>
              <ul aria-label={`${project.title} technologies`}>
                {project.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
    <a class="github-link" href={Links.asahiGithub}
      >See more on GitHub <span aria-hidden="true">↗</span></a
    >
  </div>
  <div class="wave"></div>
</section>

<style lang="scss">
  @use "../styles/variables.scss";
  @use "../styles/breakpoints.scss";
  .portfolio {
    padding: 5rem 1.25rem 0;
  }
  .container {
    width: min(1120px, 100%);
    margin: 0 auto;
  }
  .heading {
    max-width: 720px;
    margin-bottom: 2.5rem;
  }
  .eyebrow,
  .card-eyebrow {
    color: variables.$primary-color;
    font-weight: 800;
    letter-spacing: 0.14em;
    font-size: 0.78rem;
  }
  h2 {
    color: variables.$secondary-color;
    font-size: clamp(2.25rem, 6vw, 4.5rem);
    line-height: 1.02;
    margin: 0.55rem 0 1rem;
    letter-spacing: -0.04em;
  }
  .intro {
    color: variables.$secondary-color;
    font-size: 1.1rem;
    line-height: 1.7;
  }
  .project-grid {
    display: grid;
    gap: 1.25rem;
  }
  .card {
    overflow: hidden;
    border: 1px solid rgba(10, 146, 155, 0.16);
    border-radius: 24px;
    background: #fff;
    box-shadow: 0 16px 50px rgba(52, 74, 76, 0.08);
  }
  .image-wrap {
    min-height: 250px;
    background: #dcebed;
  }
  .image-wrap :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 250px;
    object-fit: cover;
  }
  .code-art {
    min-height: 250px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    place-items: center;
    color: #fff;
    background: linear-gradient(135deg, #087982, #0a929b 55%, #59bbc1);
    font-size: clamp(1.2rem, 4vw, 2.5rem);
    font-weight: 900;
    letter-spacing: 0.08em;
  }
  .code-art span:first-child {
    opacity: 0.45;
  }
  .card-content {
    padding: 1.75rem;
  }
  h3 {
    color: variables.$secondary-color;
    font-size: clamp(1.55rem, 3vw, 2.1rem);
    margin: 0.5rem 0 0.8rem;
  }
  .description {
    color: variables.$secondary-color;
    line-height: 1.65;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 1.35rem 0 0;
    list-style: none;
  }
  li {
    color: #087982;
    background: #e6f3f4;
    border-radius: 999px;
    padding: 0.45rem 0.7rem;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .github-link {
    display: block;
    width: fit-content;
    margin: 2.25rem auto 4rem;
    color: variables.$primary-color;
    font-size: 1.05rem;
    font-weight: 800;
    border-bottom: 2px solid currentColor;
    padding-bottom: 0.2rem;
  }
  .wave {
    width: 100vw;
    height: 22px;
    margin-left: calc(50% - 50vw);
    background: url("/images/wave.png") repeat-x;
    background-size: auto 22px;
  }
  @media (min-width: breakpoints.$tablets) {
    .portfolio {
      padding-top: 7rem;
    }
    .project-grid {
      grid-template-columns: 1.3fr 0.7fr;
      align-items: stretch;
    }
    .card {
      display: flex;
      flex-direction: column;
    }
    .card-content {
      padding: 2rem;
    }
    .image-wrap,
    .image-wrap :global(img),
    .code-art {
      min-height: 330px;
    }
  }
</style>
