---
// Static, CSS-only loading card, visible only in world mode (src/styles/world.css).
// WP-07's title card removes #boot-card when it first renders.
---

<div id="boot-card" aria-hidden="true">
  <div class="boot-card__inner">
    <span class="boot-card__spinner"></span>
    <p class="boot-card__title" lang="en">
      Ash Kuroki · Tokyo
    </p>
  </div>
</div>
